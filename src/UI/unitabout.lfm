    Anchors = [akTop, akLeft, akRight]
    BorderSpacing.Left = 7
    BorderSpacing.Top = 8
    BorderSpacing.Right = 9
    Color = 16119285
    Font.CharSet = ANSI_CHARSET
    Font.Height = -12
    Font.Name = 'Segoe UI'
    Lines.Strings = (
      'QUANTUM-DOCK: DeepSpace OS is a tactical space navigation simulator developed in Lazarus/FPC. Showcasing robust desktop application capabilities, it features a multithreaded Keplerian physics engine, custom BGRABitmap UI rendering, dynamic BASS audio integration, and SQLite-backed telemetry logging. It blends rigorous mathematical simulation with an immersive, retro-futuristic terminal experience.'
    )
    ParentFont = False
    ReadOnly = True
    TabOrder = 1
  end
